# Copy this file to .env and fill in your values. Never commit .env.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Model used for grading. The "latest" alias tracks Google's current Flash model.
EVALORA_MODEL=gemini-flash-latest

# true = use the built-in fake grader (no API calls), useful for demos and tests
EVALORA_MOCK_GRADER=false

# How many students are graded at the same time (keep low on the free tier)
EVALORA_MAX_CONCURRENCY=2

# Sign-in for a deployed copy. Leave the password empty to run locally without sign-in.
EVALORA_USERNAME=teacher
EVALORA_PASSWORD=
